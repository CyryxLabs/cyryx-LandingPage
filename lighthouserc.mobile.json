{
  "ci": {
    "collect": {
      "url": ["http://127.0.0.1:4175/"],
      "startServerCommand": "bun run build:lighthouse && bun scripts/serve-lighthouse.mjs",
      "startServerReadyPattern": "Local:",
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "emulatedFormFactor": "mobile",
        "throttlingMethod": "simulate",
        "onlyCategories": ["performance", "accessibility", "seo", "best-practices"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": "LH_PERF_MIN" }],
        "categories:accessibility": ["error", { "minScore": "LH_A11Y_MIN" }],
        "categories:seo": ["error", { "minScore": "LH_SEO_MIN" }],
        "largest-contentful-paint": ["error", { "maxNumericValue": "LH_LCP_MAX_MOBILE" }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": "LH_CLS_MAX" }],
        "total-blocking-time": ["error", { "maxNumericValue": "LH_TBT_MAX_MOBILE" }],
        "max-potential-fid": ["error", { "maxNumericValue": "LH_INP_MAX_MOBILE" }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "./lighthouse-report/mobile" }
  }
}
