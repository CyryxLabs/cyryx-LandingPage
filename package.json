{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && if [ -n \"$CI\" ]; then bun run test:a11y; fi",
    "build:dev": "vite build --mode development",
    "build:ci": "CI=1 bun run build",
    "preview": "vite preview",
    "test:a11y": "playwright test --config=playwright.config.ts",
    "test:a11y:update-jsonld": "UPDATE_JSONLD_SNAPSHOT=1 playwright test --config=playwright.config.ts --grep \"JSON-LD\"",
    "test:a11y:ci": "A11Y_REPORT_DIR=a11y-report playwright test --config=playwright.config.ts",
    "quality:validate-terms": "node scripts/validate-forbidden-terms.mjs",
    "quality:axe-sarif": "node scripts/axe-to-sarif.mjs a11y-report a11y-report/axe.sarif",
    "quality:lhci:mobile": "node scripts/render-lhci-config.mjs lighthouserc.mobile.json lhci.runtime.mobile.json && bunx @lhci/cli@0.14.x autorun --config=./lhci.runtime.mobile.json",
    "quality:lhci:desktop": "node scripts/render-lhci-config.mjs lighthouserc.desktop.json lhci.runtime.desktop.json && bunx @lhci/cli@0.14.x autorun --config=./lhci.runtime.desktop.json",
    "quality:fetch-artifacts": "node scripts/fetch-quality-artifacts.mjs",
    "quality:local": "node scripts/quality-local.mjs",
    "seo:self-check": "node scripts/seo-self-check.mjs",
    "seo:lighthouse": "node scripts/lighthouse-seo-audit.mjs",
    "seo:post-deploy": "node scripts/post-deploy-verify-gsc.mjs",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
