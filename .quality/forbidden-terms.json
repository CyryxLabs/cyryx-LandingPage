{
  "$schema": "./forbidden-terms.schema.json",
  "description": "Compliance + positioning guardrails. Each entry is a label + regex source (JS flavor). Override at runtime with FORBIDDEN_TERMS_FILE=path/to/file.json.",
  "terms": [
    { "label": "SOC 2 claim", "pattern": "\\bSOC\\s?2\\b", "flags": "i" },
    { "label": "ISO 27001 claim", "pattern": "\\bISO\\s?27001\\b", "flags": "i" },
    { "label": "HIPAA claim", "pattern": "\\bHIPAA\\b", "flags": "" },
    { "label": "Fake metric 148+", "pattern": "\\b148\\+", "flags": "" },
    { "label": "Fake metric 62%", "pattern": "\\b62%", "flags": "" },
    { "label": "Fake metric 97.4%", "pattern": "\\b97\\.4%", "flags": "" },
    { "label": "Fake metric 24 models", "pattern": "\\b24\\s+models\\b", "flags": "i" },
    { "label": "Competitor: Cursor", "pattern": "\\bCursor\\b", "flags": "" },
    { "label": "Competitor: Windsurf", "pattern": "\\bWindsurf\\b", "flags": "" },
    { "label": "Competitor: Copilot", "pattern": "\\bCopilot\\b", "flags": "" },
    { "label": "VS Code plugin framing", "pattern": "\\bVS\\s?Code\\s+plugin\\b", "flags": "i" },
    { "label": "Unsupported flagship claim", "pattern": "\\bflagship\\s+product\\b", "flags": "i" },
    {
      "label": "Solution as operating system",
      "pattern": "\\bowned\\s+operating\\s+system\\b",
      "flags": "i"
    },
    {
      "label": "Unsupported response SLA",
      "pattern": "\\btypically\\s+(reply|respond)\\s+within\\s+24\\s*(h|hours?)\\b",
      "flags": "i"
    }
  ]
}
