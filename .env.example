# Required in Vercel Preview and Production. These public values are shared by
# the browser bundle, SSR, and public API routes.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional server-only overrides. Leave unset to reuse the VITE_* values above.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=

# Optional. Required only for server operations that explicitly use elevated access.
# SUPABASE_SERVICE_ROLE_KEY=
